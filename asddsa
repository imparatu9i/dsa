-- ANTI DROP CORE
-- Always enabled. No menu/toggle required.
do
    if not _G._UT6AntiDropInstalled then
        local mt = getrawmetatable(game)
        local oldIdx, oldNewIdx
        local spoofedVelocity = Vector3.zero
        local antiDropActive = false

        local function startAntiDrop()
            if antiDropActive or not mt then return end
            oldIdx = mt.__index
            oldNewIdx = mt.__newindex
            setreadonly(mt, false)

            mt.__index = newcclosure(function(self, key)
                if not checkcaller() and (key == "AssemblyLinearVelocity" or key == "Velocity")
                    and typeof(self) == "Instance" and self:IsA("BasePart")
                    and self.Name == "HumanoidRootPart" and LP.Character
                    and self:IsDescendantOf(LP.Character) then
                    return spoofedVelocity
                end
                return oldIdx(self, key)
            end)

            mt.__newindex = newcclosure(function(self, key, value)
                if not checkcaller() and (key == "AssemblyLinearVelocity" or key == "Velocity")
                    and typeof(self) == "Instance" and self:IsA("BasePart")
                    and self.Name == "HumanoidRootPart" and LP.Character
                    and self:IsDescendantOf(LP.Character) then
                    spoofedVelocity = value
                    return
                end
                return oldNewIdx(self, key, value)
            end)

            setreadonly(mt, true)
            antiDropActive = true
        end

        startAntiDrop()

        LP.CharacterAdded:Connect(function()
            task.wait(0.1)
            if not antiDropActive then startAntiDrop() end
        end)

        _G._UT6AntiDropInstalled = true
    end
end


-- ANTI BAT CORE
do
    local AntiBatConn = nil
    local Speed = 10000
    local Angle = 0
    local Direction = 1

    local function stopAntiBat()
        if AntiBatConn then
            pcall(function() AntiBatConn:Disconnect() end)
            AntiBatConn = nil
        end
        Speed = 10000
        Angle = 0
        Direction = 1
        _G._UT6DuelsAntiBatDesiredXZ = nil
        _G._UT6DuelsAntiBatSpiking = false
    end

    local function startAntiBat()
        stopAntiBat()
        AntiBatConn = RunService.Heartbeat:Connect(function()
            if not _G.UT6DuelsAntiBatEnabled then return end
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root or not root.Parent then return end

            local origXZ = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)

            Speed = Speed + (50 * Direction)
            if Speed >= 20000 then
                Speed = 20000
                Direction = -1
            elseif Speed <= 10000 then
                Speed = 10000
                Direction = 1
            end

            Angle = Angle + (math.random() * 0.5)
            local radius = Speed + math.random(-5000, 5000)
            local newX = math.cos(Angle) * radius
            local newZ = math.sin(Angle) * radius

            _G._UT6DuelsAntiBatSpiking = true
            root.Velocity = Vector3.new(newX, root.Velocity.Y, newZ)

            RunService.RenderStepped:Wait()

            if root.Parent then
                local want = _G._UT6DuelsAntiBatDesiredXZ
                if want then
                    root.Velocity = Vector3.new(want.X, root.Velocity.Y, want.Z)
                else
                    root.Velocity = Vector3.new(origXZ.X, root.Velocity.Y, origXZ.Z)
                end
            end
            _G._UT6DuelsAntiBatSpiking = false
        end)
    end

    _G.UT6DuelsAntiBatEnabled = _G.UT6DuelsAntiBatEnabled == true

    local function step(_, fn)
        pcall(fn)
    end

    _G.UT6DuelsAntiBat = {
        setEnabled = function(on)
            on = on and true or false
            _G.UT6DuelsAntiBatEnabled = on
            if on then
                step("startAntiBat", startAntiBat)
            else
                step("stopAntiBat", stopAntiBat)
            end
        end,
        isEnabled = function()
            return _G.UT6DuelsAntiBatEnabled == true
        end,
    }

    task.spawn(function()
        while true do
            task.wait(0.5)
            if _G.UT6DuelsAntiBatEnabled then
                if not AntiBatConn then
                    step("watchdog:start", startAntiBat)
                end
            elseif AntiBatConn then
                step("watchdog:stop", stopAntiBat)
            end
        end
    end)

    LP.CharacterAdded:Connect(function(char)
        if _G._UT6DuelsWaitCharReady then
            _G._UT6DuelsWaitCharReady(char, 10)
        end
        if _G.UT6DuelsAntiBatEnabled then
            startAntiBat()
        else
            stopAntiBat()
        end
    end)
end

